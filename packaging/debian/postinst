#!/bin/sh
set -e

if ! getent group sfsd >/dev/null; then
    addgroup --system sfsd >/dev/null
fi

if ! getent passwd sfsd >/dev/null; then
    adduser --system --ingroup sfsd --home /var/lib/sfsd --no-create-home --disabled-login sfsd >/dev/null
fi

install -d -o sfsd -g sfsd -m 0755 /var/lib/sfsd
install -d -o sfsd -g sfsd -m 0755 /var/lib/sfsd/public
install -d -o sfsd -g sfsd -m 0755 /var/lib/sfsd/data
install -d -o sfsd -g sfsd -m 0755 /var/log/sfsd

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
